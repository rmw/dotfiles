#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname $0)"/..

RUN_MACOS_SOFTWARE_UPDATE=false
for arg in "$@"; do
  case "$arg" in
    --macos-update)
      RUN_MACOS_SOFTWARE_UPDATE=true
      ;;
  esac
done

# Run the priority installers first so other installers can depend on Brew and mise.
PRIORITY_INSTALLERS=(
  "./homebrew/install.sh"
  "./mise/install.sh"
)
for installer in "${PRIORITY_INSTALLERS[@]}"; do
  if [ -f "$installer" ]; then
    bash "$installer"
  fi
done

# find the remaining installers and run them iteratively
find . -name install.sh -print | while read -r installer ; do
  skip=false
  for priority in "${PRIORITY_INSTALLERS[@]}"; do
    if [ "$installer" = "$priority" ]; then
      skip=true
      break
    fi
  done
  if [ "$skip" = true ]; then
    continue
  fi

  if [ "$installer" = "./macos/install.sh" ] && [ "$RUN_MACOS_SOFTWARE_UPDATE" = true ]; then
    bash "$installer" --macos-update
  else
    bash "$installer"
  fi
done

# Ensure Homebrew is in PATH for future shells
BREW_PATH="/opt/homebrew/bin/brew"
PROFILE="$HOME/.zprofile"
if [ -f "$BREW_PATH" ]; then
  if ! grep -q 'eval "\$\(/opt/homebrew/bin/brew shellenv\)"' "$PROFILE" 2>/dev/null; then
    echo "Adding Homebrew to PATH in $PROFILE"
    echo '' >> "$PROFILE"
    echo 'eval "$('/opt/homebrew/bin/brew' shellenv)"' >> "$PROFILE"
    eval "$('/opt/homebrew/bin/brew' shellenv)"
  fi
fi
